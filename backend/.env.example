APP_NAME=Airbnb Clone API
DEBUG=true
DATABASE_URL=sqlite:///./airbnb.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated exact origins allowed to call the API (your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: https://airbnb-clone-.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Create tables and seed demo data when the database is empty
SEED_ON_STARTUP=true
